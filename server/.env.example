# ============================================================
# CARESYNC AI — Environment Configuration
# ============================================================

# Server
PORT=5001
JWT_SECRET=caresync-dev-secret-key-change-in-production

# AI Provider Configuration
# Options: 'local' (built-in knowledge base), 'openai', 'gemini', 'anthropic'
AI_PROVIDER=local

# For external AI APIs (future use)
# AI_API_KEY=your-api-key-here
# AI_MODEL=gpt-4o

# Database
DATABASE_URL="file:./caresync.db"

# Storage
UPLOAD_DIR=./uploads
